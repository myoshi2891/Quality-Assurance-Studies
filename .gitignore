# ========================================
# AI Model Pricing .gitignore
# ========================================

# OS
.DS_Store
Thumbs.db

# IDE / Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.history/
*.iml
*.swp
*.swo

# Python (scraper/)
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
.Python
.mypy_cache/
*.egg-info/
.pytest_cache/

# Node.js (web/)
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Security / Environment
.env
.env.local
.env.*.local
!.env.example
credentials.json
config.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Data / Generated Assets (Root)
# Set these if you want to keep generated assets out of Git
/index.html
/pricing.json
/*.png
/*.ico

# Backup/Temp
*.tmp
*.bak

# temp files
links.md

# Claude Code local settings (personal, not shared)
CLAUDE.local.md

# git worktree のチェックアウト先を追跡対象から除外（必須）
worktrees/
sample-docs

# Claude Code local settings
.claude/settings.local.json

.next
next-env.d.ts
/html-archive/
/md-archive/
# Markdown Formatting Scripts
scripts/fix-md
fix_spacing.mjs
scripts/auto-fix-fences-v2.mjs
scripts/check_links.mjs
scripts/check-fences.mjs
scripts/fix-md-errors.mjs
scripts/fix-md028.mjs
scripts/fix-toc.mjs

.playwright-mcp

# Playwright E2E artifacts
/playwright-report/
/test-results/
/playwright/.cache/
.lighthouseci

# archive/ は原則無視。ただしテストがバイト単位で照合する原本は CI でも必要なため追跡する
/archive/*
!/archive/html-archive/
!/archive/md-archive/
/archive/html-archive/**
/archive/md-archive/**
!/archive/html-archive/books/
!/archive/md-archive/books/
!/archive/html-archive/ct-specialist/
!/archive/md-archive/ct-specialist/
!/archive/html-archive/books/Beyond-legacy-code-guide.html
!/archive/md-archive/books/Beyond-legacy-code-guide.md
!/archive/html-archive/ct-specialist/Ct-genai-study-guide.html
!/archive/md-archive/ct-specialist/Ct-genai-study-guide.md
!/archive/html-archive/iso/
!/archive/md-archive/iso/
!/archive/html-archive/iso/Iso-29119-1-2022-guide.html
!/archive/md-archive/iso/Iso-29119-1-2022-guide.md
/plans/