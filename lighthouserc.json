{
  "ci": {
    "collect": {
      "startServerCommand": "bun run start",
      "startServerReadyPattern": "ready - started server on|Ready in",
      "numberOfRuns": 3,
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/acceptance-testing-guide",
        "http://127.0.0.1:3000/e2e-testing-guide",
        "http://127.0.0.1:3000/istqb-ct-ai-complete-guide"
      ],
      "settings": {
        "blockDomains": ["*.googleapis.com", "*.gstatic.com"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["warn", { "maxNumericValue": 15000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 1500 }],
        "categories:performance": ["warn", { "minScore": 0.4 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
